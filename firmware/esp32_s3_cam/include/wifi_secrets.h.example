/**
 * @file wifi_secrets.h.example
 * @brief Mẫu credential Wi-Fi. COPY sang `wifi_secrets.h` rồi điền giá trị thật.
 *
 * `wifi_secrets.h` đã nằm trong `.gitignore` và KHÔNG được commit.
 *
 * Chuẩn H3: ESP32-S3-CAM chỉ chạy STA, nối vào hotspot 2.4 GHz của laptop GCS
 * hoặc router trạm mặt đất. Không phát SoftAP (ESP32-C3 gateway đã giữ
 * 192.168.4.1).
 */

#pragma once

// SSID hotspot/router. Phải là băng tần 2.4 GHz — ESP32-S3 không hỗ trợ 5 GHz.
#define KVC_WIFI_SSID "ten-hotspot-2g-cua-ban"

// Mật khẩu WPA2. Để "" nếu hotspot mở (không khuyến nghị).
#define KVC_WIFI_PASSWORD "mat-khau-cua-ban"
