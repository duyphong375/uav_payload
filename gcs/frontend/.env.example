# KVC UAV Payload GCS Environment Configuration
# Không đặt bí mật hay token nhạy cảm vào các biến VITE_* (chúng sẽ xuất hiện trong client bundle)

# Backend REST API URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend WebSocket URL for Telemetry & State
VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry

# Video Stream URL (MJPEG / Web stream)
VITE_VIDEO_STREAM_URL=http://localhost:8000/video/stream

# Nguồn bản đồ nền (Tile URL template)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Chế độ nguồn dữ liệu mặc định (REAL / MOCK / REPLAY)
VITE_DEFAULT_SOURCE_MODE=MOCK

# LOCAL: demo trong browser, không mở WS; BACKEND: server MOCK qua WS, không fallback
VITE_MOCK_TRANSPORT=LOCAL

# Tần số quét cảnh báo STALE (ms)
VITE_STALE_THRESHOLD_MS=3000
